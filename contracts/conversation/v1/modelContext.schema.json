{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0"
    },
    "conversationId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "phase": {
      "type": "string",
      "enum": [
        "COLLECTING",
        "AWAITING_LINK",
        "SEARCHING",
        "PROPOSALS_READY",
        "EDITING_CART",
        "AWAITING_APPROVAL",
        "SUBMITTING",
        "CONFIRMED",
        "FAILED",
        "RESULT_UNKNOWN"
      ]
    },
    "participantRefs": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{16,64}$"
      }
    },
    "pending": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[\\s\\S]{1,2000}$"
      }
    }
  },
  "required": [
    "contractVersion",
    "conversationId",
    "version",
    "phase",
    "participantRefs",
    "pending"
  ],
  "additionalProperties": false
}
