{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "conversationId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "channel": {
              "type": "string",
              "const": "TELEGRAM"
            },
            "botId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "conversationId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "kind": {
              "type": "string",
              "const": "MESSAGE"
            },
            "messageId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            }
          },
          "required": [
            "channel",
            "botId",
            "conversationId",
            "kind",
            "messageId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "channel": {
              "type": "string",
              "const": "TELEGRAM"
            },
            "botId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "conversationId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "kind": {
              "type": "string",
              "const": "CALLBACK"
            },
            "messageId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "callbackQueryId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
          },
          "required": [
            "channel",
            "botId",
            "conversationId",
            "kind",
            "messageId",
            "callbackQueryId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "reviewRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,64}$"
    },
    "approvalRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,64}$"
    }
  },
  "required": [
    "contractVersion",
    "eventId",
    "conversationId",
    "expectedVersion",
    "source",
    "reviewRef",
    "approvalRef"
  ],
  "additionalProperties": false
}
