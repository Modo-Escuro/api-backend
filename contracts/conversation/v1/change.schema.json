{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "changeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,64}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "channel": {
              "type": "string",
              "const": "TELEGRAM"
            },
            "botId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "conversationId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "kind": {
              "type": "string",
              "const": "MESSAGE"
            },
            "messageId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            }
          },
          "required": [
            "channel",
            "botId",
            "conversationId",
            "kind",
            "messageId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "channel": {
              "type": "string",
              "const": "TELEGRAM"
            },
            "botId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "conversationId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "kind": {
              "type": "string",
              "const": "CALLBACK"
            },
            "messageId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "callbackQueryId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
          },
          "required": [
            "channel",
            "botId",
            "conversationId",
            "kind",
            "messageId",
            "callbackQueryId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "baseVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resultVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "paths": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PARTICIPANTS",
          "CONDITIONS",
          "BUDGET",
          "PROPOSALS",
          "CART",
          "PHASE"
        ]
      }
    },
    "cause": {
      "type": "string",
      "enum": [
        "USER",
        "DERIVED"
      ]
    }
  },
  "required": [
    "changeId",
    "eventId",
    "source",
    "baseVersion",
    "resultVersion",
    "paths",
    "cause"
  ],
  "additionalProperties": false
}
