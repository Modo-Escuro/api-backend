# Copie para .env (ou rode `npm run setup:env` para gerar a partir do OpenCode).
IFOOD_MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
# Deve ser IDÊNTICO ao redirect registrado no client OAuth (no OpenCode está sem /callback).
IFOOD_REDIRECT_URI=http://localhost:8000
# Opcional: escopos a pedir no login (vazio = não envia `scope`, o AS decide).
IFOOD_SCOPE=
# Para onde o callback OAuth devolve o navegador (frontend Vite em dev).
WEB_ORIGIN=http://localhost:5173
PORT=8000

# ---- Integração com o bot Telegram (docs/bot-api.md)
# Segredo bot→API (mínimo 32 caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOT_API_TOKEN=
# IDs numéricos do Telegram autorizados como organizador (separados por vírgula). Demo: um único ID.
ALLOWED_ORGANIZER_IDS=
# Base do backend usada no link "Conectar iFood" (abrir no navegador da MESMA máquina do backend).
PUBLIC_BASE_URL=http://localhost:8000
# Diretório dos vínculos (fora do Git).
IFOOD_LINKS_DIR=.ifood-links
# Sessão global antiga (/api/auth/*). Apenas desenvolvimento; nunca é importada como vínculo Telegram.
DEV_GLOBAL_SESSION=false

# F7: manter desligado até validar as saídas reais do MCP; correções #2/#3 já integradas. Nunca habilita checkout.
IFOOD_CART_ENABLED=false
# RUN-01: infraestrutura desativada por padrão; não habilita IA nem compras.
# Para ativar, usar diretório exclusivo em volume persistente (OPS-01).
CONVERSATION_RUNTIME_ENABLED=false
CONVERSATION_DB_FILE=
# ID numérico retornado por getMe; NÃO é token do BotFather.
BOT_TELEGRAM_ID=
