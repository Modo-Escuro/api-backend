# Copie para .env (ou rode `npm run setup:env` para gerar a partir do OpenCode).
IFOOD_MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
# Deve ser IDÊNTICO ao redirect registrado no client OAuth (no OpenCode está sem /callback).
IFOOD_REDIRECT_URI=http://localhost:8000
# Opcional: escopos a pedir no login (vazio = não envia `scope`, o AS decide).
IFOOD_SCOPE=
# Para onde o callback OAuth devolve o navegador (frontend Vite em dev).
WEB_ORIGIN=http://localhost:5173
PORT=8000

# ---- Integração com o bot Telegram (docs/bot-api.md)
# Segredo bot→API (mínimo 32 caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOT_API_TOKEN=
# IDs numéricos do Telegram autorizados como organizador (separados por vírgula). Demo: um único ID.
ALLOWED_ORGANIZER_IDS=
# Demo com senha no bot: aceita novos IDs somente pelo adaptador autenticado, com X-Telegram-Access: PASSWORD.
# A senha fica exclusivamente no bot; desligado por padrão. Não habilita compras nem o modelo.
BOT_PASSWORD_ACCESS_ENABLED=false
# Base do backend usada no link "Conectar iFood" (abrir no navegador da MESMA máquina do backend).
PUBLIC_BASE_URL=http://localhost:8000
# Diretório dos vínculos (fora do Git). Em deploy, DEVE ficar num volume persistente (docs/ops-01-persistencia.md).
# Railway: com volume montado e esta variável vazia, o padrão é $RAILWAY_VOLUME_MOUNT_PATH/ifood-links.
IFOOD_LINKS_DIR=.ifood-links
# Somente migração/emergência: aceitar novos vínculos em disco sabidamente efêmero (se perdem no próximo deploy).
IFOOD_LINKS_ALLOW_EPHEMERAL=false
# Sessão global antiga (/api/auth/*). Apenas desenvolvimento; nunca é importada como vínculo Telegram.
DEV_GLOBAL_SESSION=false

# F7 legada: manter desligada. CART-01 usa opt-in, evidência e confirmação humana separados abaixo.
IFOOD_CART_ENABLED=false
# RUN-01: infraestrutura desativada por padrão; não habilita IA nem compras.
# Para ativar, usar diretório exclusivo em volume persistente (OPS-01).
CONVERSATION_RUNTIME_ENABLED=false
CONVERSATION_DB_FILE=
# ID numérico retornado por getMe; NÃO é token do BotFather.
BOT_TELEGRAM_ID=

# AI-01: Gemini (escolhido no ensaio do PR #35), desligado por padrão. Sem modelo implícito nem fallback determinístico.
# Habilitar só com runtime + bot autenticado configurados e autorização de gasto. Chave apenas no ambiente da API.
# A chave sozinha não ativa nada; F7 e sessão global precisam estar desligadas.
CONVERSATION_MODEL_ENABLED=false
CONVERSATION_MODEL_PROVIDER=google
CONVERSATION_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
CONVERSATION_MODEL_TIMEOUT_MS=15000
CONVERSATION_MODEL_MAX_OUTPUT_TOKENS=2048
# Obrigatório ao habilitar (1–100000). Contadores por processo: reinício zera (persistência/alertas: OPS-02).
CONVERSATION_MODEL_MAX_REQUESTS=
CONVERSATION_MODEL_MAX_REQUESTS_PER_CONVERSATION=200
# Reserva local de gasto em micro-USD (2000000 = US$ 2). Não substitui o limite de cobrança no console do Google.
CONVERSATION_MODEL_BUDGET_MICRO_USD=2000000
# Avaliação local (npm run ai:demo:gemini / eval:agent -- --live): use uma chave EXCLUSIVA de teste, nunca a de produção.
AI_EVAL_GEMINI_API_KEY=
# CART-01: manter desligado até evidência de saídas reais e ensaio humano autorizado em teste.
IFOOD_CONFIRMED_CART_WRITES_ENABLED=false
# IFOOD_CART_CONTRACT_EVIDENCE_FILE=/caminho/privado/cart-contract-evidence.json
