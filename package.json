{
  "name": "compra-com-contexto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "start": "tsx --env-file-if-exists=.env src/server/index.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ai:manifest": "tsx scripts/evaluate-ai.ts --manifest",
    "ai:eval:offline": "tsx scripts/evaluate-ai.ts --offline",
    "ai:eval:live": "tsx scripts/evaluate-ai.ts --live",
    "ai:demo:offline": "tsx scripts/evaluate-claude-demo.ts",
    "ai:demo:gemini": "tsx scripts/evaluate-claude-demo.ts --live --provider=google",
    "ai:demo:claude": "tsx scripts/evaluate-claude-demo.ts --live --provider=anthropic",
    "contract:generate": "tsx scripts/export-conversation-contract.ts && tsx scripts/conversation-examples.ts",
    "test:contract": "vitest run test/contracts/conversation.test.ts",
    "setup:env": "node scripts/setup-env-from-opencode.mjs",
    "auth:import-opencode": "node scripts/import-opencode-token.mjs",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "links": "tsx --env-file-if-exists=.env scripts/links-admin.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/google": "4.0.99",
    "@ai-sdk/groq": "4.0.63",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ai": "7.0.143",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
